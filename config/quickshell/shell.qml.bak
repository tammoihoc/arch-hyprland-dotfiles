
import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Widgets
import Quickshell.Wayland
import "./features/bar" as Bar
import "./features/launcher" as Launcher
import "./features/power" as Power
import "modules"

ShellRoot {
    PanelWindow {
        id: topBar

        anchors {
            top: true
            left: true
            right: true
        }

        implicitHeight: 42
        color: "transparent"
        exclusiveZone: 42

        WlrLayershell.layer: WlrLayer.Top
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

        Rectangle {
            id: barBackground

            anchors.fill: parent
            anchors.topMargin: 4
            anchors.bottomMargin: 4
            anchors.leftMargin: 12
            anchors.rightMargin: 12

            color: "#181825"
            radius: 12
            border.color: "#313244"
            border.width: 1

            // BÊN TRÁI: MENU + WORKSPACES
            RowLayout {
                anchors.left: parent.left
                anchors.leftMargin: 8
                anchors.verticalCenter: parent.verticalCenter
                spacing: 8

                Launcher.StartMenu {
                    id: startMenu
                    Layout.preferredWidth: 32
                    Layout.preferredHeight: 28
                }

                Bar.Workspaces {
                    id: workspaces
                }
            }

            // CHÍNH GIỮA: ĐỒNG HỒ
            Bar.ClockWidget {
                id: clock
                anchors.centerIn: parent
            }

            // BÊN PHẢI: SYSTEM STATS + POWER
            RowLayout {
                anchors.right: parent.right
                anchors.rightMargin: 8
                anchors.verticalCenter: parent.verticalCenter
                spacing: 8

                Bar.SystemStats {
                    id: systemStats
                }
Power.PowerMenu {
    id: powerMenu

    Layout.preferredWidth: 32
    Layout.preferredHeight: 28

    Layout.alignment: Qt.AlignVCenter
}
            }
        }
    }
}
